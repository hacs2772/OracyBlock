# OracyBlock 설정 파일 (start.bat 이 처음 실행될 때 이 파일을 .env 로 복사해요)
# ⚠ .env 는 비밀번호가 들어 있어서 깃허브에 올라가지 않아요 (.gitignore)

# 자동으로 랜덤 값이 채워져요. 바꾸지 마세요 (바꾸면 로그인이 풀리거나 DB에 못 들어가요)
DB_PASSWORD=CHANGE_ME_AUTO
JWT_SECRET=CHANGE_ME_AUTO

# 직접 채워야 하는 것 3개
# Cloudflare 터널 토큰 (docs/deploy.md 2단계)
TUNNEL_TOKEN=CHANGE_ME
# 관리자 계정: 이 이메일·비밀번호로 사이트에 로그인하면 내 정보에 "관리자 화면"이 생겨요
ADMIN_EMAIL=CHANGE_ME
# 10자 이상, 나만 아는 것
ADMIN_PASSWORD=CHANGE_ME

# 관리자 닉네임 (순위에 보여요)
ADMIN_NICKNAME=운영자
